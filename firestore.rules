rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'admin';
    }

    function isBusiness() {
      return isSignedIn() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'negocio';
    }

    function isValidDocumentSize() {
      return request.resource.size() < 1048576;
    }

    // ── Usuarios ──────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(userId) &&
                       request.resource.data.id == userId &&
                       isValidDocumentSize();
      allow update: if isSignedIn() && (
        (isOwner(userId) && request.resource.data.id == resource.data.id) ||
        isAdmin()
      ) && isValidDocumentSize();
      allow delete: if isOwner(userId) || isAdmin();

      // Notificaciones del usuario
      match /notifications/{notifId} {
        allow read: if isSignedIn() && isOwner(userId);
        allow create: if isSignedIn();
        allow update: if isSignedIn() && isOwner(userId);
        allow delete: if isSignedIn() && isOwner(userId);
      }
    }

    // ── Planes ────────────────────────────────────────────────────
    match /plans/{planId} {
      function isPlanOrganizer() {
        return resource.data.organizadorId == request.auth.uid;
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
                       request.resource.data.organizadorId == request.auth.uid;
      allow update: if isSignedIn() && (
        isPlanOrganizer() ||
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['participantesIds', 'listaEsperaIds', 'capacidadActual',
                    'puntuacionPromedio', 'totalResenas'])
      );
      allow delete: if isPlanOrganizer() || isAdmin();

      // Mensajes del chat
      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isSignedIn() && (
          resource.data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/plans/$(planId)).data.organizadorId == request.auth.uid
        );
        allow delete: if isAdmin();
      }

      // Reseñas del plan
      match /reviews/{reviewId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() &&
                         request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    // ── Directorio de espacios ────────────────────────────────────
    match /spaces/{spaceId} {
      // Cualquier usuario autenticado puede ver espacios aprobados
      allow read: if isSignedIn();

      // Solo negocios o admins pueden crear espacios
      allow create: if isSignedIn() && (isBusiness() || isAdmin()) &&
                       request.resource.data.negocioId == request.auth.uid;

      // El dueño puede actualizar su espacio; admin puede actualizar cualquiera
      allow update: if isSignedIn() && (
        resource.data.negocioId == request.auth.uid ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // ── Reportes ──────────────────────────────────────────────────
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() &&
                       request.resource.data.reporterId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Regla por defecto ─────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'admin';
    }

    // Validar tamaño del documento (máximo 1MB por limitación de Firestore)
    function isValidDocumentSize() {
      return request.resource.size() < 1048576; // 1MB en bytes
    }

    // Reglas para la colección de usuarios
    match /users/{userId} {
      // Cualquier usuario autenticado puede leer perfiles públicos
      allow read: if isSignedIn();

      // Solo el dueño puede crear su propio perfil
      allow create: if isSignedIn() &&
                       isOwner(userId) &&
                       request.resource.data.id == userId &&
                       request.resource.data.email == request.auth.token.email &&
                       isValidDocumentSize();

      // Solo el dueño puede actualizar su propio perfil
      // No puede cambiar: id, email, rol, reputacion, verificado
      allow update: if isSignedIn() &&
                       isOwner(userId) &&
                       request.resource.data.id == resource.data.id &&
                       request.resource.data.email == resource.data.email &&
                       request.resource.data.rol == resource.data.rol &&
                       request.resource.data.reputacion == resource.data.reputacion &&
                       request.resource.data.verificado == resource.data.verificado &&
                       isValidDocumentSize();

      // Solo el dueño o admin pueden eliminar
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Reglas para la colección de planes
    match /plans/{planId} {
      // Helper para verificar si es organizador del plan
      function isPlanOrganizer() {
        return resource.data.organizadorId == request.auth.uid;
      }

      // Validar datos del plan
      function isValidPlan() {
        let data = request.resource.data;
        return data.titulo.size() > 0 &&
               data.titulo.size() <= 100 &&
               data.capacidadMaxima > 0 &&
               data.capacidadMaxima <= 100 &&
               data.capacidadActual >= 0 &&
               data.capacidadActual <= data.capacidadMaxima;
      }

      // Cualquier usuario autenticado puede leer planes
      allow read: if isSignedIn();

      // Solo usuarios autenticados pueden crear planes
      allow create: if isSignedIn() &&
                       request.resource.data.organizadorId == request.auth.uid &&
                       isValidPlan() &&
                       isValidDocumentSize();

      // Actualizaciones: organizador o participantes (para join/leave)
      allow update: if isSignedIn() && (
        // Organizador puede actualizar todo excepto cambiar organizador
        (isPlanOrganizer() &&
         request.resource.data.organizadorId == resource.data.organizadorId) ||
        // Cualquier usuario puede unirse/salir (modificar arrays de participantes)
        (request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['participantesIds', 'listaEsperaIds', 'capacidadActual']))
      ) && isValidDocumentSize();

      // Solo organizador o admin pueden eliminar
      allow delete: if isPlanOrganizer() || isAdmin();
    }

    // Reglas por defecto: denegar todo lo demás
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
